<Window x:Class="RoleplayDiary.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading, RelativeSource={RelativeSource Self}}"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        MaxWidth="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="26,22,26,20">
        <TextBlock Style="{StaticResource TitleText}" Text="{Binding Heading, RelativeSource={RelativeSource AncestorType=Window}}" />

        <TextBlock Margin="0,10,0,20"
                   MaxWidth="440"
                   HorizontalAlignment="Left"
                   Style="{StaticResource MutedText}"
                   Text="{Binding Body, RelativeSource={RelativeSource AncestorType=Window}}"
                   TextWrapping="Wrap" />

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="DismissButton"
                    Style="{StaticResource GhostButton}"
                    Click="OnDismiss"
                    Content="Close"
                    IsCancel="True" />

            <Button x:Name="ConfirmButton"
                    Margin="8,0,0,0"
                    Click="OnConfirm"
                    Content="Delete"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
