<Window x:Class="RoleplayDiary.Views.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Heading}"
        Width="620"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="28,24,28,22">
        <TextBlock Style="{StaticResource TitleText}" Text="{Binding Heading}" />

        <StackPanel Margin="0,18,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="WHAT HAPPENED" />
            <TextBox x:Name="TitleBox"
                     Style="{StaticResource InputTextBox}"
                     Tag="Married Halvard at the old chapel"
                     Text="{Binding Draft.Title, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="OnTitleChanged" />
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource FieldLabel}" Text="KIND" />
                <ComboBox Style="{StaticResource ThemedComboBox}"
                          ItemsSource="{Binding KindChoices}"
                          SelectedItem="{Binding Draft.Kind}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource FieldLabel}" Text="WHEN" />
                <TextBox Style="{StaticResource InputTextBox}"
                         Tag="2026-06-20, 20 June 2026, today, or blank"
                         Text="{Binding Draft.WhenText, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="OnWhenChanged" />
                <TextBlock Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{Binding WhenHintBrush}"
                           Text="{Binding WhenHint}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Margin="0,14,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="THE TELLING" />
            <TextBox Height="180"
                     Style="{StaticResource MultilineTextBox}"
                     Tag="What happened, and what it meant to them."
                     Text="{Binding Draft.Body}" />
        </StackPanel>

        <StackPanel Margin="0,22,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Style="{StaticResource GhostButton}"
                    Click="OnCancel"
                    Content="Cancel"
                    IsCancel="True" />
            <Button Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnSave"
                    Content="{Binding SaveLabel}"
                    IsDefault="True"
                    IsEnabled="{Binding CanSave}" />
        </StackPanel>
    </StackPanel>
</Window>
